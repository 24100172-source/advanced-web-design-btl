<%- include('../partials/header') %>
<%- include('../partials/adminNavbar') %> <!-- Dùng Navbar dành riêng cho Admin -->

<main class="container my-5" style="min-height: 80vh;">
  
  <div class="row">
    <div class="col-12">
      
      <!-- Card bọc toàn bộ nội dung quản lý món ăn -->
      <div class="card rounded-4 shadow-lg border-0 p-4 p-md-5" style="background-color: #161920; border: 1px solid #2a2c35 !important;">
        
        <!-- Tiêu đề & Nút Thêm mới -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary">
          <div>
            <span class="text-warning text-uppercase small tracking-wider" style="letter-spacing: 2px;">Hệ Thống Quản Trị</span>
            <h2 class="text-white fw-bold mb-0">Quản Lý Món Ăn</h2>
          </div>
          
          <!-- Nút hành động -->
          <div class="d-flex gap-2 align-items-center">
            <a href="/admin/dishes/add" class="btn btn-warning fw-bold text-dark px-4 py-2 shadow-sm">
              <i class="bi bi-plus-lg me-1"></i> Thêm món mới
            </a>
          </div>
        </div>

        <!-- Bảng hiển thị danh sách món ăn -->
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
            <thead>
              <tr class="text-secondary text-uppercase fs-7" style="font-size: 0.85rem; border-bottom: 2px solid #2a2c35;">
                <th class="py-3">STT</th>
                <th class="py-3">Tên món ăn</th>
                <th class="py-3">Danh mục</th>
                <th class="py-3">Giá tiền</th>
                <th class="py-3">Trạng thái</th>
                <th class="py-3 text-center">Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.dishes && dishes.length > 0) { %>
                <% dishes.forEach((dish, index) => { %>
                  <tr style="border-bottom: 1px solid #222630;">
                    <td class="fw-bold text-warning">#<%= index + 1 %></td>
                    
                    <td class="fw-semibold text-white">
                      <!-- Nếu có ảnh thì hiện thumbnail nhỏ ở đây cũng rất đẹp, tạm thời mình để tên món -->
                      <%= dish.name %>
                    </td>
                    
                    <td>
                      <!-- Badge danh mục -->
                      <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1">
                        <%= dish.category_name %>
                      </span>
                    </td>
                    
                    <td class="text-white fw-bold">
                      <%= dish.price.toLocaleString('vi-VN') %>đ
                    </td>
                    
                    <td>
                      <% if (dish.status === 1) { %>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-2">Đang bán</span>
                      <% } else { %>
                        <span class="badge bg-secondary bg-opacity-25 text-white-50 border border-secondary border-opacity-25 px-3 py-2">Tạm ngưng</span>
                      <% } %>
                    </td>
                    
                    <td class="text-center">
                      <div class="d-flex justify-content-center gap-1">
                        
                        <!-- Nút Sửa -->
                        <a href="/admin/dishes/edit/<%= dish.id %>" class="btn btn-sm btn-primary text-white shadow-sm" title="Sửa thông tin">
                          <i class="bi bi-pencil-square"></i>
                        </a>

                        <!-- Nút Xóa -->
                        <a href="/admin/dishes/delete/<%= dish.id %>" class="btn btn-sm btn-danger text-white shadow-sm" onclick="return confirm('Bạn có chắc muốn xóa vĩnh viễn món ăn này?');" title="Xóa món ăn">
                          <i class="bi bi-trash"></i>
                        </a>
                        
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-white-50 py-5">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-warning"></i>
                    Chưa có món ăn nào trong hệ thống.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>

    </div>
  </div>

</main>

<%- include('../partials/footer') %>